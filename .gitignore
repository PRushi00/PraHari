# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Real environment files. The .example variants are committed; these
# are not, because .env is where a real token or path ends up.
.env
.env.*
!.env.*.example
!*.env.example

# Virtual environments
.venv/
venv/
ENV/
env/

# Pytest / Coverage
.pytest_cache/
.coverage
htmlcov/

# Node / Frontend
node_modules/
frontend/dist/
frontend/node_modules/
.npm
*.log

# SQLite databases — NEVER commit these.
# The operational database contains genuine network telemetry collected from
# the local host: local and remote IP addresses, ports, connection times and
# owning process ids. That is sensitive information about the operator's
# machine and browsing, and it must not enter version control.
*.db
prahari.db
prahari_test.db
prahari_test*.db
prahari_live_verify.db
*.db-journal
# Backups taken before an authorized migration. These are COPIES of the
# operational database and carry exactly the same telemetry, but a name
# like `prahari.db.prestop-20261017` does not end in `.db`, so the rule
# above does not match it. Ignore the whole directory by name instead of
# trusting a suffix pattern to catch every backup naming scheme.
db_backups/
*.db.prestop-*
*.db.backup*
*.db.bak
*.db-wal
*.db-shm

# IDE & OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Experiment manifests are reproducibility records, not telemetry: they
# contain counts, hashes and configuration only. They are kept out of the
# default commit set because they are run artifacts; commit one explicitly
# when it documents a result worth preserving.
experiments/

# Central-mode credentials. The file stores HASHES only, but it still
# identifies every authorised source and must never be committed.
secrets/
credentials.json
*credentials*.json

# ── Research corpora and local data (added for benchmark readiness) ──
# Benchmark CSVs are large third-party artefacts with their own licence and
# attribution terms. They are never committed: the repository would carry
# redistributed data, and a multi-hundred-megabyte file would be in every
# clone forever. Small synthetic fixtures written BY the test suite are not
# affected — they live in temporary directories, not here.
# Root-anchored on purpose. An unanchored `research/` would match
# backend/app/research/ — the source package — and silently hide it from
# version control. Verified with `git check-ignore`.
/research/
/research-data/
/datasets/
/data/raw/
/data/corpora/
*.pcap
*.pcapng

# Local CSV data. Deliberately scoped so documentation, source and small
# committed fixtures are untouched; only the data drop locations above and
# top-level stray CSVs are excluded.
/*.csv
/backend/*.csv
/frontend/*.csv

# Research import manifests sit beside the research database and record
# local filenames and hashes.
manifests/
