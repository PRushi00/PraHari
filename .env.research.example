# PraHari — Research Store Configuration (EXAMPLE — placeholders only)
#
# Copy to .env, or export these in the shell that starts the backend.
# This file contains no real paths, credentials or secrets, and must not be
# edited to contain any: .env itself is gitignored, this example is not.
#
# ─────────────────────────────────────────────────────────────────────
# Why a second database
# ─────────────────────────────────────────────────────────────────────
# The operational database holds genuine network observations collected
# from this host. It is the only copy. A benchmark corpus is a third-party
# artefact with its own labels, provenance and licence.
#
# PraHari keeps them apart and FAILS CLOSED: a research import with no
# research store configured — or one that resolves to the operational
# database — is refused before any row is read. There is no fallback.

# Operational telemetry (leave at the default unless you have a reason).
# PRAHARI_DATABASE_URL=sqlite:///./prahari.db

# Research corpora. MUST NOT be the operational database.
# The parent directory must already exist; PraHari does not create storage
# locations implicitly.
PRAHARI_RESEARCH_DATABASE_URL=sqlite:///./research/benchmark.db

# ─────────────────────────────────────────────────────────────────────
# Safe first setup (nothing here acquires a dataset)
# ─────────────────────────────────────────────────────────────────────
#   mkdir research
#   export PRAHARI_RESEARCH_DATABASE_URL=sqlite:///./research/benchmark.db
#   curl http://127.0.0.1:8000/api/v1/research/import/status
#
# To rehearse against a throwaway store instead, point it at a temporary
# directory you create yourself. Both ./research/ and ./datasets/ are
# gitignored, as are *.pcap and top-level *.csv.
#
# ─────────────────────────────────────────────────────────────────────
# Importing (dry run by default)
# ─────────────────────────────────────────────────────────────────────
# POST /api/v1/research/import/csv
# {
#   "file_path": "./datasets/example-flows.csv",
#   "dataset_name": "<dataset name you supply>",
#   "dataset_release": "<release identifier you supply>",
#   "source_id": "<a source id you choose>",
#   "timestamp_format": "iso",        # auto | day_first | month_first | iso
#   "source_timezone": null,          # null when the source documents none
#   "duration_unit": "microseconds",  # seconds | milliseconds | microseconds | unknown
#   "require_bidirectional_counts": true,
#   "dry_run": true
# }
#
# timestamp_format: "auto" REJECTS a date that could be read either as
#   dd/mm/yyyy or mm/dd/yyyy rather than picking one.
# source_timezone: leave null if the publisher does not document one. The
#   uncertainty is recorded in the manifest; it is not papered over.
# duration_unit: "unknown" means the duration column is NOT imported.
#   An unconverted microsecond value is a 10^6x error nothing downstream
#   would catch.
